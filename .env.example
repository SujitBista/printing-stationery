# Application
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/printing_stationery

# Auth / sessions
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=ps_session
SESSION_DURATION_HOURS=8
# Defaults to true in production, false otherwise when unset
COOKIE_SECURE=false
SESSION_LAST_SEEN_THROTTLE_SECONDS=300

# Bootstrap first Admin (script only; never commit real values)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
