# Backend
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/printing_stationery

# Auth / sessions
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=ps_session
SESSION_DURATION_HOURS=8
COOKIE_SECURE=false
SESSION_LAST_SEEN_THROTTLE_SECONDS=300

# Bootstrap first Admin (npm run auth:bootstrap-admin)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
